# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git (см. .gitignore) — здесь только плейсхолдеры.

# --- Postgres (используется контейнером db и для сборки DATABASE_URL backend'а) ---
POSTGRES_USER=domradar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=domradar

# --- Полный DSN приложения ---
# Внутри docker-compose переопределяется автоматически (host=db), это значение
# нужно только для локального запуска backend'а без docker-compose.
DATABASE_URL=postgresql+psycopg2://domradar:change-me@localhost:5432/domradar

# --- MAX Bot API ---
MAX_BOT_TOKEN=put-your-max-bot-token-here
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_API_TIMEOUT_SECONDS=5
MAX_API_MAX_RETRIES=3
MAX_CA_BUNDLE=certs/russian_trusted_root_ca.pem

# --- Общий секрет для проверки входящих webhook-запросов от бота ---
# ОБЯЗАТЕЛЕН вне ENVIRONMENT=local/test/development: без него, со значением-
# заглушкой ниже или короче 16 символов все /webhook/* отвечают 503.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SHARED_SECRET=change-me-shared-secret

# --- SLA-таймер ---
SLA_THRESHOLD_HOURS=24
SLA_CHECK_INTERVAL_MINUTES=60

# --- Хранение фото от жителей (volume внутри контейнера) ---
PHOTOS_STORAGE_DIR=/data/photos
# Максимальный размер фото, которое backend скачает по ссылке (байт)
PHOTO_MAX_BYTES=10485760
# Хосты, с которых можно скачивать фото (через запятую, поддомены разрешены),
# например CDN MAX. Пусто = любой публичный хост (внутренние адреса запрещены всегда).
PHOTO_ALLOWED_HOSTS=

# --- Ограничения входных данных и защита от дублей ---
# Максимальный размер тела HTTP-запроса (байт); больше — ответ 413
MAX_REQUEST_BODY_BYTES=65536
# Повтор того же текста от того же жителя по открытому инциденту в пределах
# этого окна (сек) считается дублем и не создаёт новую заявку; 0 — выключить
DUPLICATE_MESSAGE_WINDOW_SECONDS=600

# --- Порт, на котором backend будет доступен на хост-машине ---
BACKEND_PORT=8000

# --- Прочее ---
LOG_LEVEL=INFO
ENVIRONMENT=production
